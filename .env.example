GEMINI_API_KEY=COLE_SUA_API_KEY_AQUI

# Fallback LLM para quando a quota do Gemini esgotar (Groq: 1000 req/dia grátis)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=COLE_SUA_GROQ_API_KEY_AQUI

# Instagram (necessário para instagram_creator/instagram_publish_0_1.py)
# INSTAGRAM_USER_ID: ID numérico da conta Business/Creator (ex: 123456789)
# INSTAGRAM_ACCESS_TOKEN: token de longa duração gerado no Meta for Developers
# SITE_BASE_URL: URL base do site publicado, sem barra no final
INSTAGRAM_USER_ID=SEU_IG_USER_ID_AQUI
INSTAGRAM_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
SITE_BASE_URL=https://resenhadanacao.com.br

# X / Twitter (necessário para x_creator/x_publish_0_1.py)
X_USERNAME=seu_arroba_sem_o_arroba
X_PASSWORD=sua_senha_do_x
